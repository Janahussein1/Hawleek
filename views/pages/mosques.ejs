<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Hawaleek | Mosques</title>
    <link rel="stylesheet" href="/css/mosques.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="logo">Hawaleek</div>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/services">Directory</a></li>
                <li><a href="/booking">Booking</a></li>
                <li><a href="/transport">Transport</a></li>
                <li><a href="/clinics">Clinics</a></li>
                <li><a href="/mosques" class="active">Mosques</a></li>
                <li><a href="/toilets">Restrooms</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="page-header">
            <h1>Nearby Mosques</h1>
            <p>Find local mosques, prayer times, and facilities.</p>
        </section>

        <section class="directory-layout">
            <div class="services-wrapper">
                
                <article class="card">
                    <img src="/photos/mosque.jpg" alt="Al-Rahman Mosque">
                    <div class="cards-content">
                        <span class="status-tag">Open Now</span>
                        <h3>Al-Rahman Mosque</h3>
                        <p>Main Street, 5 mins walk from Dokki Square.</p>
                        <p>Walk south on Dokki Street, then left onto Main Street and continue 350m to the mosque entrance.</p>
                        <a href="https://www.google.com/maps/dir/?api=1&destination=30.0384,31.2114&travelmode=walking" target="_blank" rel="noreferrer" class="book-link">Open Route</a>
                    </div>
                </article>

                <article class="card">
                    <img src="/photos/mosque2.jpg" alt="Al-Nour Mosque">
                    <div class="cards-content">
                        <span class="status-tag">Friday Prayers</span>
                        <h3>Al-Nour Mosque</h3>
                        <p>West District, has women's prayer area.</p>
                        <p>Head north on West Avenue, turn right at Market Street and walk 600m to the mosque.</p>
                        <a href="https://www.google.com/maps/dir/?api=1&destination=30.0396,31.2008&travelmode=walking" target="_blank" rel="noreferrer" class="book-link">Open Route</a>
                    </div>
                </article>

            </div>
        </section>
    </main>

    <footer>
        <div class="footer-content">
            <p>&copy; 2026 Hawaleek Project. All rights reserved.</p>
            <ul class="footer-links">
                <li><a href="#">Privacy Policy</a></li>
                <li><a href="#">Terms Of Service</a></li>
                <li><a href="#">Contact Us</a></li>
            </ul>
        </div>
    </footer>

    <script src="/js/mosques.js"></script>
</body>
</html>