<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head> 
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= __("nav_transport") %> | <%= __("logo_title") %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/transport.css">
    <style>
      .lang-switcher a {
        background: #0f6e56; color: #fff !important;
        padding: 6px 12px; border-radius: 8px; font-weight: bold;
        font-size: 0.9rem; transition: background 0.2s ease; text-decoration: none;
      }
      .lang-switcher a:hover { background: #115f4f; }
      [dir="rtl"] .navbar ul { direction: rtl; }
    </style>
  <script>
    window.__translations = <%- translationsJson %>;
  </script>
</head>
<body> 
    <header> 
        <nav class="navbar">
            <div class="logo"><%= __("logo_title") %></div>
            <ul> 
                <li><a href="/"><%= __("nav_home") %></a></li>
                <li><a href="/services"><%= __("nav_directory") %></a></li>
                <li><a href="/booking"><%= __("nav_bookings") %></a></li>
                <li><a href="/clinics"><%= __("nav_clinics") %></a></li>
                <li><a href="/transport" class="active"><%= __("nav_transport") %></a></li>
                <li><a href="/mosques"><%= __("nav_mosques") %></a></li>
                <li><a href="/toilets"><%= __("nav_restrooms") %></a></li>
                <li data-show="guest"><a href="/dashboard/login"><%= __("nav_admin") %></a></li>
                <li data-show="auth" style="display: none;"><a href="/dashboard"><%= __("nav_dashboard") %></a></li>
                <li data-show="auth" style="display: none;"><a href="#" onclick="logout(); return false;"><%= __("nav_logout") %></a></li>
                <li class="lang-switcher">
                  <% if (locale === 'en') { %><a href="?lang=ar">العربية</a><% } else { %><a href="?lang=en">English</a><% } %>
                </li>
            </ul>
        </nav>
    </header>

    <main> 
        <section class="transport-header">
            <h1><%= __("transport_title") %></h1>
            <p><%= __("transport_desc") %></p>
        </section>

        <section class="transport-tools-wrapper">
            <div class="tool-card">
                <h2>📍 <%= __("transport_route_finder") %></h2>
                <div class="input-group"> 
                    <input type="text" id="destination" placeholder="<%= __("transport_to_placeholder") %>">
                </div>
                <button class="action-btn" id="findRouteBtn"><%= __("transport_find_btn") %></button>
                <div id="routeResults" style="margin-top: 15px;"></div>
            </div>

            <div class="tool-card">
                <h2>💰 <%= __("transport_calculator") %></h2>
                <div class="input-group">
                    <label style="font-size: 0.8rem; margin-left: 10px;"><%= __("transport_vehicle_type") %></label>
                    <select id="transportType">
                        <option value="microbus"><%= __("transport_opt_microbus") %></option>
                        <option value="metro"><%= __("transport_opt_metro") %></option>
                        <option value="bus"><%= __("transport_opt_bus") %></option>
                    </select>
                </div>
                <div class="input-group">
                    <input type="number" id="stations" min="0" placeholder="<%= __("transport_stations_placeholder") %>">
                </div>
                <div class="fare-result">
                    <%= __("transport_estimated_fare") %> <strong><span id="fareResult">0.00</span> EGP</strong>
                </div>
            </div>

            <div class="tool-card">
                <h2>📢 <%= __("transport_live_status") %></h2>
                <div class="live-status-item">
                    <span>Metro Line 1</span>
                    <span class="status-clear">● <%= __("transport_status_clear") %></span>
                </div>
                <div class="live-status-item">
                    <span>Main Square Station</span>
                    <span class="status-text">● <%= __("transport_status_crowded") %></span>
                </div>
            </div>
        </section>

        <div class="routes-grid">
            <div class="route-card">
                <div class="route-img-wrapper">
                    <img src="/photos/transportation.jpg" alt="route">
                </div>
                <div class="route-info">
                    <strong>Route: Haram - Giza</strong>
                    <p><%= __("transport_next_microbus") %>5 mins</p>
                    <p style="font-size: 0.8rem; color: gray;">Station: El-Remaya</p>
                </div>
            </div>

            <div class="route-card">
                <div class="route-img-wrapper">
                    <img src="/photos/transportation.jpg" alt="route">
                </div>
                <div class="route-info">
                    <strong>Route: Dokki - Ramses</strong>
                    <p><%= __("transport_next_microbus") %>12 mins</p>
                    <p style="font-size: 0.8rem; color: gray;">Station: Galaa Square</p>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="footer-content">
            <p>&copy; <%= new Date().getFullYear() %> <%= __("footer_text") %></p>
            <ul class="footer-links">
                <li><a href="#"><%= __("footer_privacy") %></a></li>
                <li><a href="#"><%= __("footer_terms") %></a></li>
                <li><a href="#"><%= __("contact_title") %></a></li>
            </ul>
        </div>
    </footer>
    <script src="/public/api.js"></script>
    <script src="/js/calculator.js"></script>
</body>
</html>