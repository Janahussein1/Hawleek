<!DOCTYPE html> 
<html lang="en"> 
<head> 
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Hawaleek | Clinics </title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/clinics.css">
</head>
<body>
    <header> 
        <nav class="navbar">
            <div class="logo"> Hawaleek </div>  
            <ul>
                <li> <a href="/"> Home </a></li>
                <li> <a href="/services"> Local Directory </a></li>
                <li> <a href="/clinics" class="active"> Clinics </a></li>
                <li> <a href="/booking"> Booking </a> </li>
                <li> <a href="/transport"> Transport </a></li>
                <li> <a href="/mosques"> Mosques </a></li>
                <li> <a href="/toilets"> Restrooms </a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="page-header">
            <h1>Neighborhood Medical Services</h1>
            <p>Find trusted doctors and healthcare providers near you.</p>
        </section>

        <section class="directory-layout">
            <div class="services-wrapper">
                
                <article class="card">
                    <img src="/photos/generalclinic.jpg" alt="General Clinic">
                    <div class="cards-content">
                        <h3>Al-Amal Medical Center</h3>
                        <p>General practitioners, Pediatrics, and Lab tests.</p>
                        <span class="status-tag">Open Now</span>
                        <a href="/booking" class="book-link"> Book Appointment </a>
                    </div>
                </article>

                <article class="card">
                    <img src="/photos/dentistoffice.jpg" alt="Dentist Office">
                    <div class="cards-content">
                        <h3>Modern Dental Care</h3>
                        <p>Cosmetic dentistry, cleaning, and emergency repairs.</p>
                        <span class="status-tag">Appointment Only</span>
                        <a href="/booking" class="book-link"> Book Appointment </a>
                    </div>
                </article>

                <article class="card">
                    <img src="/photos/pharamcy.jpg" alt="Local Pharmacy">
                    <div class="cards-content">
                        <h3>24/7 Neighborhood Pharmacy</h3>
                        <p>Prescriptions, vitamins, and home delivery services.</p>
                        <span class="status-tag">24 Hours</span>
                        <a href="tel:01XXXXXXXXX" class="call-link"> Call Pharmacy </a>
                    </div>
                </article>

            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Hawaleek Project | Medical Section</p>
    </footer>

    <script src="/js/clinics.js"> </script>
</body>
</html>
