<!DOCTYPE html> 
<html lang="en"> 
<head> 
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Hawaleek | Home </title>
    <link rel="stylesheet" href="/css/style.css">
    
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="logo"> Hawaleek </div>
            <ul>
                <li> <a href="/" class="active"> Home </a></li>
                <li> <a href="/booking"> Restaurants </a> </li>
                <li> <a href="/clinics"> Clinics </a></li>
                <li> <a href="/transport"> Transport </a></li>
                <li> <a href="/dashboard/login"> Admin </a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section id="hero" style="padding:48px 24px;text-align:center;background:linear-gradient(180deg,#f8fffe,white);">
            <h1 style="font-size:2.4rem;margin-bottom:12px;">Hawaleek — Your Neighborhood, Connected</h1>
            <p style="max-width:900px;margin:0 auto 18px;color:#374151;line-height:1.6;">Discover trusted businesses nearby, reserve tables at local restaurants, book medical appointments, and find transport — all in one place. Fast, local, and designed for your community.</p>
            <div style="margin-top:18px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
                <a href="/booking" class="primary-btn">Reserve a Table</a>
                <a href="/clinics" class="secondary-btn">Book a Clinic</a>
                <a href="/transport" class="secondary-btn">Find Transport</a>
            </div>
        </section>

        <section id="search" style="padding:36px 24px;max-width:1120px;margin:0 auto;">
            <h2 style="margin-top:0">Find what you need</h2>
            <form id="searchform" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <input type="text" id="searchQuery" name="searchQuery" placeholder="Search for a restaurant, clinic, or service..." style="flex:1;min-width:220px;padding:10px;border-radius:8px;border:1px solid #d1d5db">
                <select id="category" style="padding:10px;border-radius:8px;border:1px solid #d1d5db">
                    <option value="all">All Categories</option>
                    <option value="restaurant">Restaurants</option>
                    <option value="clinic">Clinics</option>
                    <option value="transport">Transport</option>
                    <option value="toilet">Restrooms</option>
                    <option value="service">Services</option>
                </select>
                <button type="submit" class="primary-btn">Search</button>
            </form>
            <div id="search-results" style="margin-top:18px"></div>
        </section>

        <section id="about" style="padding:48px 24px;background:#ffffff;">
            <div style="max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start">
                <div>
                    <h2>About Hawaleek</h2>
                    <p style="color:#374151;line-height:1.7">Hawaleek connects neighbors with reliable local businesses and services. We make it easy to discover nearby restaurants, schedule healthcare appointments, and navigate local transport. Our mission is to help communities thrive by making essential local resources discoverable and bookable.</p>
                    <h3 style="margin-top:18px">Why choose us</h3>
                    <ul style="color:#374151;line-height:1.7">
                        <li>Curated local listings vetted for quality.</li>
                        <li>Fast, simple booking with email confirmations.</li>
                        <li>Privacy-conscious and community-focused.</li>
                    </ul>
                </div>
                <div style="background:#f8fffe;border:1px solid #e6fffa;padding:18px;border-radius:12px">
                    <h3>Contact</h3>
                    <p style="margin:0 0 12px;color:#374151">Have a question or want to partner with us? Send a message and we'll reply soon.</p>
                    <form id="contact-form">
                        <input type="text" id="contact-name" placeholder="Your name" required style="width:100%;padding:10px;border-radius:8px;border:1px solid #d1d5db;margin-bottom:8px">
                        <input type="email" id="contact-email" placeholder="Your email" required style="width:100%;padding:10px;border-radius:8px;border:1px solid #d1d5db;margin-bottom:8px">
                        <textarea id="contact-message" placeholder="Message" required style="width:100%;padding:10px;border-radius:8px;border:1px solid #d1d5db;margin-bottom:8px;min-height:120px"></textarea>
                        <button type="submit" class="primary-btn">Send Message</button>
                    </form>
                    <p id="contact-result" style="margin-top:10px;color:#374151"></p>
                </div>
            </div>
        </section>

        <footer style="padding:28px 24px;text-align:center;color:#6b7280">
            <div style="max-width:900px;margin:0 auto">
                <p style="margin:0">© ${new Date().getFullYear()} Hawaleek · Your Neighborhood Guide</p>
            </div>
        </footer>

    </main>

    <script src="/public/api.js"></script>
    <script src="/js/home.js"></script>
</body>
</html>